# ── Credentials & Secrets ──────────────────────────────────────────────────
/config/credentials/
backend/credentials/
backend/CREDENTIALS.md
CREDENTIALS.md
credentials.json
**/credentials.json
# GOOGLE_CREDS_PATH defaults to credentials.json (book_event/management/commands/
# sync_bookings_from_sheets.py); token.* is what an OAuth flow writes back beside
# it, and a refresh token is as sensitive as the client secret.
token.json
token.pickle
# Every .md file, repo-wide, and deliberately so — this repo tracks no markdown
# at all, which is what keeps a CREDENTIALS.md or a pasted-in dump of connection
# strings from being committed by reflex. A doc that genuinely belongs in git
# needs `git add -f`.
*.md
*.pem
*.key
*.p12
service-account*.json

# ── Environment Variables ───────────────────────────────────────────────────
# .env* rather than a list of suffixes: settings.py reads config via
# python-decouple/dotenv, and the previous rules covered .env and .env*.local
# but NOT .env.production or .env.staging — the two most costly to leak.
.env
.env.*
!.env.example
!.env.sample

# ── Dependency Checks ───────────────────────────────────────────────────────
backend/.deps_check/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.Python

# Django
# Machine-local settings overrides, which is where a local DB password ends up.
local_settings.py
db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal
*.sqlite3
# Collected static and uploaded media are both generated. NOTE: the rule is
# `staticfiles/`, never `static/` — frontend/public/static holds real committed
# logo assets, and react-scripts' own output lands in frontend/build/static,
# which `build/` below already covers.
staticfiles/
media/
*.log

# Testing
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
nosetests.xml
*.egg-info/
dist/
*.egg
MANIFEST

# Generated reports (not source data)
backend/*.csv
backend/*.xlsx

# ── Node / React ─────────────────────────────────────────────────────────────
node_modules/
build/
.pnp
.pnp.js
.eslintcache
coverage/
*.tgz

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Browser tests ────────────────────────────────────────────────────────────
# frontend/tests/*.mjs and the @playwright/test dependency were removed — they
# were one-off debugging harnesses for already-fixed bugs, run by nothing. These
# rules stay so an ad-hoc Playwright run's large, regenerated artefacts (which
# land in the repo root or frontend/ by default) still cannot be committed.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
*.userosscache
*.sln.docstates
.project
.classpath
.settings/
.claude/

# Scratch, backup and merge leftovers
*.bak
*.orig
*.rej
*.tmp
*~

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
# A file literally named `nul`, which Windows creates when a command redirects
# to NUL from a POSIX shell (`… > /dev/null` is the portable form here).
nul
