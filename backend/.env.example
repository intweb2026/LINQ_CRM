# Copy to backend/.env and fill in. Never commit the real .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Set DATABASE_URL *or* the DB_* block. Required whenever DEBUG=False.
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Email ───────────────────────────────────────────────────────────────────────
# THE LOGIN AND THE SENDER ARE TWO DIFFERENT THINGS. EMAIL_HOST_USER is who the
# CRM authenticates to the mail server as; DEFAULT_FROM_EMAIL is whose name is on
# the message. They do not have to match, which is what lets mail come from a
# person without the server holding that person's mailbox password.
#
# Pick ONE of the three transports below. Verify whichever you pick with
#   python manage.py preview_paper_review_email --diagnose --to you@example.com
# which prints the server's literal reply to every SMTP command, including the
# queue id to search in the provider's delivery log when a message is accepted
# but never arrives.

# 1. GOOGLE WORKSPACE SMTP RELAY. The right answer for a Workspace domain. The
#    admin authorises the SERVER BY IP, so there is no password here at all and
#    no 2FA is involved. Needs a static outbound IP, which a laptop does not
#    have, so local development uses option 2 or 3.
# EMAIL_HOST=smtp-relay.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# 2. GMAIL AS A USER. Needs an APP PASSWORD, 16 characters, which in turn needs
#    2 Step Verification switched on for that mailbox. The ordinary account
#    password is rejected with 535; Google removed password based SMTP sign in.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=someone@iq-hub.com
# EMAIL_HOST_PASSWORD=<16 character app password, spaces stripped>

# 3. A TRANSACTIONAL PROVIDER, for example Brevo. The relay key authenticates;
#    the From address must be a verified sender, or the domain authenticated with
#    SPF and DKIM, or the provider accepts the message and then silently drops it.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Implicit TLS on port 465 instead of STARTTLS on 587. Never set both this and
# EMAIL_USE_TLS; Django refuses to start.
EMAIL_USE_SSL=False

# Seconds before a silent relay is given up on. The send is synchronous inside
# the request that created the review, so an unbounded wait holds a worker open.
EMAIL_TIMEOUT=20

# Whose name is on every CRM email.
DEFAULT_FROM_EMAIL=
IMPORT_ALERT_EMAIL=

# ── Paper review notification ─────────────────────────────────────────────────
# Sent to the event's sales executive on every paper review form submission.
# Cc is the submitting MRE plus the standing list below.

# Must be True for anything to be sent at all. Defaults False.
PAPER_REVIEW_NOTIFICATIONS_ENABLED=True

# Standing Cc, comma-separated. Copied on every review whoever the sales
# executive is.
PAPER_REVIEW_CC_EMAILS=harry.jonas@iq-hub.com

# Watchdog. Gets the RECIPIENT FALLBACK alert (no recipient resolved from the
# event) and the SCRIPT ERROR alert (the send itself failed).
PAPER_REVIEW_ALERT_EMAIL=arthur.pina@iq-hub.com

# Where the "Open the review record" button points. No trailing slash.
CRM_BASE_URL=https://crm.iq-hub.com

# TESTING ONLY — LEAVE EMPTY IN PRODUCTION. When set, EVERY paper review email
# goes to this one address instead of its real recipients, with the intended
# To: named in the subject. A value here silently swallows the lot.
PAPER_REVIEW_REDIRECT_ALL_EMAIL=

# ── Website / Webhook Integration ─────────────────────────────────────────────
WEBSITE_API_KEY=
WEBHOOK_SECRET_KEY=

# ── Google Sheets Sync ────────────────────────────────────────────────────────
# Path is resolved relative to the repo root, not backend/.
GOOGLE_SHEETS_CREDENTIALS=config/credentials/google-sheets.json
# Target of the bookings/events push (sync/bookings_sync.py, sync/events_sync.py).
GOOGLE_SHEET_ID=
# Target of the full CRM mirror — the "CRM data" spreadsheet, one tab per module.
# Share it with the service account's client_email as an Editor. Falls back to
# GOOGLE_SHEET_ID when blank.
GOOGLE_SHEET_CRM_ID=

# ── Google Sign-In ────────────────────────────────────────────────────────────
# Web client ID from Google Cloud Console (OAuth 2.0 → Web application).
# Required. Without it, /api/auth/google/ returns 500.
# The same value goes to the frontend build as VITE_GOOGLE_CLIENT_ID.
# No client secret is needed — the ID token flow does not use one.
GOOGLE_OAUTH_CLIENT_ID=
# Comma-separated list of allowed email domains. Default: iq-hub.com,linq-corporate.com
GOOGLE_OAUTH_ALLOWED_DOMAINS=iq-hub.com,linq-corporate.com
