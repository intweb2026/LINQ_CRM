# Copy to frontend/.env and fill in. Never commit the real .env.
# This app is built by react-scripts (Create React App), so ONLY variables
# prefixed REACT_APP_ are substituted into the bundle at BUILD time. Changing
# one requires a rebuild, not just a restart. Read them as
# `process.env.REACT_APP_NAME` member access — see the comment at the top of
# src/api/client.js for why an intermediate alias silently breaks.

# ── API ───────────────────────────────────────────────────────────────────────
# Defaults to the same-origin "/api/" when unset, which is what production uses.
REACT_APP_API_BASE_URL=

# ── Google Sign-In ────────────────────────────────────────────────────────────
# The SAME Web client ID the backend reads as GOOGLE_OAUTH_CLIENT_ID.
# Required — without it the login page renders no Google button.
# No client secret belongs here; the ID token flow does not use one.
REACT_APP_GOOGLE_CLIENT_ID=
